# Olive & Ember Kitchen - Environment Configuration

# Database
# Instant local SQLite zero-config development:
DATABASE_URL="file:./dev.db"
# Managed PostgreSQL production:
# DATABASE_URL="postgresql://user:password@host:5432/olive_and_ember?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Session Secret
JWT_SECRET="dev_secret_olive_ember_9824_production_grade_jwt_token_key"

# Default Currency & Locale
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Optional Payment Gateway: Razorpay
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Optional Notifications (Email & WhatsApp)
NOTIFICATION_PROVIDER="console"
NOTIFICATION_FROM_EMAIL="reservations@oliveandember.demo"
RESEND_API_KEY=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Operational Defaults
NEXT_PUBLIC_RESTAURANT_NAME="Olive & Ember Kitchen"
NEXT_PUBLIC_RESTAURANT_PHONE="+91 98765 43210"
NEXT_PUBLIC_RESTAURANT_EMAIL="hello@oliveandember.demo"

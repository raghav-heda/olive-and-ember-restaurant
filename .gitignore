# 1. Dependencies
node_modules/
/.pnp
.pnp.js

# 2. Next.js build, deployment, and cache files
.next/
out/
build/
dist/
*.tsbuildinfo

# 3. Environment files and secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Do not ignore public example template
!.env.example

# 4. Local SQLite database and storage files
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal

# Ensure production schemas and migrations are tracked
!prisma/schema.prisma
!prisma/schema.postgresql.prisma
!prisma/migrations/**

# 5. Logs and temporary debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 6. Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

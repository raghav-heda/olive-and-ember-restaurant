{
  "name": "olive-and-ember-kitchen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/prepare-db.mjs local && next dev",
    "build": "node ./scripts/prepare-db.mjs && next build",
    "postinstall": "node ./scripts/prepare-db.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:push:prod": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:seed": "node seed.mjs",
    "db:generate": "node ./scripts/prepare-db.mjs",
    "db:generate:sqlite": "node ./scripts/prepare-db.mjs local",
    "db:generate:postgres": "node ./scripts/prepare-db.mjs postgres",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "test": "node ./scripts/prepare-db.mjs local && vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
